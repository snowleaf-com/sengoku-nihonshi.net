{
  "name": "sengoku-nihonshi-net",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run deploy:production",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && npm run db:migrate:staging && CLOUDFLARE_ENV=staging wrangler deploy --env staging",
    "deploy:production": "npm run build && npm run db:migrate:production && wrangler deploy",
    "preview:upload": "npm run build && wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply sengoku-nihonshi --local",
    "db:migrate:staging": "wrangler d1 migrations apply sengoku-nihonshi-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply sengoku-nihonshi --remote",
    "db:migrate:remote": "npm run db:migrate:production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.13.1",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "typescript": "~5.8",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
