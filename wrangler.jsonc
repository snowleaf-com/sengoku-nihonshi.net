{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sengoku-nihonshi-net",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "preview_urls": true,
  "workers_dev": true,
  // Top-level = production（手動デプロイ）
  "vars": {
    "WEBAUTHN_RP_NAME": "戦国日本史.net",
    "WEBAUTHN_RP_ID": "sengoku.snow-leaf.com",
    "WEBAUTHN_ORIGIN": "https://sengoku.snow-leaf.com",
    "SESSION_TTL_SECONDS": "15552000"
  },
  // Cloudflare ダッシュボードで付けた本番ホストを構成としても固定する
  "routes": [
    {
      "pattern": "sengoku.snow-leaf.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sengoku-nihonshi",
      "database_id": "d3135503-e663-4cdb-8322-21a48300dee0",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "env": {
    // main マージで自動デプロイする検証環境（DB は production と分離）
    // bindings（vars / d1 等）は inherit されないので staging 側に明示する
    "staging": {
      "name": "sengoku-nihonshi-net-staging",
      "vars": {
        "WEBAUTHN_RP_NAME": "戦国日本史.net (staging)",
        "WEBAUTHN_RP_ID": "sengoku-nihonshi-net-staging.yy-dec5.workers.dev",
        "WEBAUTHN_ORIGIN": "https://sengoku-nihonshi-net-staging.yy-dec5.workers.dev",
        "SESSION_TTL_SECONDS": "15552000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sengoku-nihonshi-staging",
          "database_id": "dc3566b4-738e-4d0d-83e7-b62ac4a06375",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      }
    }
  }
}
